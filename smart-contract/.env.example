# ─── Wallet Private Keys ──────────────────────────────────────────────────────
# Deployer / Admin
PRIVATE_KEY=0xYourPrivateKeyHere
# Optional specific roles
PRIVATE_KEY_ADMIN=0xYourAdminPrivateKeyHere
PRIVATE_KEY_ORGANIZER=0xYourOrganizerPrivateKeyHere

# ─── Network RPCs ─────────────────────────────────────────────────────────────
# Get these from Infura, Alchemy, or Quicknode
ALCHEMY_API_KEY=your_alchemy_api_key
INFURA_API_KEY=your_infura_api_key
SAPPHIRE_TESTNET_RPC_URL=https://testnet.sapphire.oasis.io

# ─── Explorer API Keys (for verification) ─────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# ─── Testing & Gas Reporting ──────────────────────────────────────────────────
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# ─── Deployment Config ────────────────────────────────────────────────────────
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
ORGANIZER_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Script Helper Variables ──────────────────────────────────────────────────
# Used by scripts/check-event-status.js, etc.
EVENT_IDS=1,2,3
EVENT_NAMES=Concert,Festival
OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
