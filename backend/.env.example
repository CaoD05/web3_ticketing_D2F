# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
JWT_SECRET=your_long_random_jwt_secret_here

# ─── Database Configuration (Prisma) ──────────────────────────────────────────
# PostgreSQL connection string (Supabase, Aiven, or Local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/web3_ticketing?schema=public

# ─── Web3 & Smart Contract ───────────────────────────────────────────────────
RPC_URL=https://testnet.sapphire.oasis.io
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=0xYourPrivateKeyForWriteTransactions
ADMIN_PRIVATE_KEY=0xYourAdminPrivateKey
SYNC_START_BLOCK=0

# ─── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=event-images

# ─── Pinata IPFS (Optional) ───────────────────────────────────────────────────
PINATA_JWT=your_pinata_jwt_here

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
