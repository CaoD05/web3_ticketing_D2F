PORT=5000

DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_sqlserver_password
DB_NAME=EventTicketDB

PRIVATE_KEY=0xYourPrivateKeyForWriteTransactions
# Kết nối với mạng Ethereum Sepolia qua Infura (hoặc RPC riêng)
RPC_URL=http://127.0.0.1:8545

# Địa chỉ Smart Contract
CONTRACT_ADDRESS=0xYourTicketingContractAddress

# Private Key của ví Admin (Dùng để cấp quyền/soát vé - Nhớ tuyệt đối bảo mật)
ADMIN_PRIVATE_KEY=0xYourAdminPrivateKey

# ─── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=event-images

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
