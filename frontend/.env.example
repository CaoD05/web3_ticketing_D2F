# ─── API Configuration ────────────────────────────────────────────────────────
# Base URL for the backend API
REACT_APP_API_BASE_URL=http://localhost:5000/api

# ─── Authentication ───────────────────────────────────────────────────────────
# Google OAuth Client ID
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Web3 Configuration ───────────────────────────────────────────────────────
# Optional: Default network name or chain ID
REACT_APP_NETWORK_NAME=sapphireTestnet

# ─── IPFS Configuration ───────────────────────────────────────────────────────
# Dedicated Pinata Gateway (if using one)
REACT_APP_IPFS_GATEWAY=https://your-dedicated-gateway.mypinata.cloud/ipfs
